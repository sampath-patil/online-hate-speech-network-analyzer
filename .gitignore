# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
venv/
env/
ENV/
.venv/

# --- Trained model artifacts ---
# The .joblib files are regenerated by clicking "Train model" in the app,
# so they don't belong in version control (they're large and binary).
models/*.joblib
models/*.pkl

# --- Streamlit ---
# Keep .streamlit/config.toml (it's the theme, and it's committed on purpose)
# but never commit secrets.
.streamlit/secrets.toml

# --- Jupyter ---
.ipynb_checkpoints/

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp

# --- OS cruft ---
.DS_Store
Thumbs.db
desktop.ini
